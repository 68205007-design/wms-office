# ===== Database (MySQL 8) =====
# รูปแบบ: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://wms:wms_password@localhost:3306/wms_db"

# ===== Server =====
PORT=4000
NODE_ENV=development

# ===== JWT =====
# เปลี่ยนเป็นข้อความสุ่มยาว ๆ ก่อนใช้งานจริง (เช่น openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# ===== CORS =====
# โดเมนของ frontend ที่อนุญาต คั่นด้วย , (เช่น https://username.github.io)
CORS_ORIGIN="http://localhost:5173"

# URL สาธารณะของ backend (ใช้สร้างลิงก์รูปภาพวัสดุ) - เว้นว่างได้ตอนพัฒนา
PUBLIC_URL=""
